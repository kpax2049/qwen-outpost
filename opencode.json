{
  "$schema": "https://opencode.ai/config.json",
  "model": "freetoken/Qwen3.6-35B-A3B-NVFP4",
  "shell": "pwsh",
  "provider": {
    "freetoken": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "FreeToken",
      "options": {
        "baseURL": "http://127.0.0.1:1919/v1"
      },
      "models": {
        "Qwen3.6-35B-A3B-NVFP4": {
          "name": "Qwen3.6-35B-A3B-NVFP4",
          "limit": {
            "context": 163840,
            "output": 32768
          }
        }
      }
    }
  },
  "experimental": {
    "policies": [
      {
        "effect": "deny",
        "action": "provider.use",
        "resource": "*"
